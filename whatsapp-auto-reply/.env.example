# Copia este archivo a .env y ajusta lo que necesites. Todas las variables son opcionales.

# Ruta del archivo de contactos y ajustes (por defecto: config/contacts.json)
WA_CONFIG_PATH=config/contacts.json

# Carpeta donde se guardan la sesión de WhatsApp y el estado (por defecto: data)
WA_DATA_DIR=data

# Ruta a un Chrome/Chromium ya instalado. Si se omite, se usa el Chromium que descarga puppeteer.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Ejecutar el navegador sin ventana (true por defecto). Pon false para depurar.
WA_HEADLESS=true

# Nivel de log: debug | info | warn | error
WA_LOG_LEVEL=info
