  },
  "sources": {
    "polymarket": {
      "enabled": true,
      "endpoint": "https://gamma-api.polymarket.com/events",
      "query": "tag_slug=nfl&closed=false&limit=200"
    },
    "kalshi": {
      "enabled": true,
      "endpoint": "https://api.elections.kalshi.com/trade-api/v2/markets",
      "series_ticker": "KXNFLGAME"
    },
    "injuries": {
      "enabled": true,
      "endpoint": "https://site.api.espn.com/apis/site/v2/sports/football/nfl/injuries"
    },
    "news": {
      "enabled": true,
      "endpoint": "https://site.api.espn.com/apis/site/v2/sports/football/nfl/news",
      "query": "limit=50"
    }
  },
  "consensus": {
    "model_weight": 0.5
